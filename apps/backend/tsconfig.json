{
  "compilerOptions": {
    "target": "ES2020",
    "module": "Node16",
    "moduleResolution": "node16",

    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,

    "strict": true,
    "skipLibCheck": true,

    "typeRoots": ["./src/types", "./node_modules/@types"],

    "rootDir": "../../",
    "outDir": "./dist"
  },
  "include": ["src", "../../packages/shared-types/src"]
}